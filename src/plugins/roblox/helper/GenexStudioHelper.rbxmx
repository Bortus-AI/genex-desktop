<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="Script" referent="RBXGENEX0">
		<Properties>
			<string name="Name">GenexStudioHelper</string>
			<bool name="Disabled">false</bool>
			<ProtectedString name="Source"><![CDATA[--!strict
-- The Genex helper for Roblox Studio. Genex added this file to Studio's Plugins folder when you
-- pressed Set up, and Undo Set up in Genex takes it away again. It runs only in Edit: a play
-- session's copies return at once.
local GENEX_HELPER_VERSION = 1

local RunService = game:GetService("RunService")
if not RunService:IsEdit() then
	return
end

print(`Genex helper {GENEX_HELPER_VERSION} loaded`)
]]></ProtectedString>
		</Properties>
	</Item>
</roblox>
